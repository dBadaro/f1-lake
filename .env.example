# Template das variáveis do collector. NÃO commite o .env real.
# O .env fica na raiz do repo (gitignored) e é carregado por collector/config.py;
# para colocá-lo em outro lugar, defina F1_LAKE_DOTENV com o caminho.

# Obrigatória: connection string do ADLS Gen2
# (Portal Azure → Storage Account → Access keys → Connection string)
AZURE_STORAGE_CONNECTION_STRING=

# Opcionais: upload adicional para o volume do Databricks (graceful degradation).
# Necessárias também para collector/sync_volume.py (espelho ADLS → volume).
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Opcionais: login F1TV para laps/weather — alternativa ao login interativo
# `python -m fastf1 auth f1tv --authenticate` (o token fica em
# %LOCALAPPDATA%\fastf1 e expira sem refresh).
F1TV_USERNAME=
F1TV_PASSWORD=
